        {
          "post": "us_dept_northeastern_virginia",
          "fromDate": "1861-05-28",
          "requiresDepartment": "us_war",
          "fromPosts": [
            "st_gov_connecticut",
            "st_gov_massachusetts",
            "st_gov_maine",
            "st_gov_michigan",
