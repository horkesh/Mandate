  "relevant_offensives": [
    {
      "post": "us_dept_northeastern_virginia",
      "objective": "manassas",
      "fromDate": "1861-07-16",
      "source": "docs/research/2026-11-14-secession-winter-1861.md, 1861-07-16: McDowell marches from Washington [WIKI-Bull]; GO1861 GO26 p.61 and OR I-2 pp.59-60 identify the command. [I] Route the existing dated goal through that command; no tactical weight or battle event changes."
    },
    {
      "id": "johnston_harpers_hold",
      "post": "cs_cmd_harpers_ferry",
      "objective": "harpers_ferry",
      "posture": "hold",
      "fromDate": "1861-06-03",
      "source": "OR I-II pp.898,901, Lee to Johnston, June3, preference for retaining Harpers Ferry; pp.907-908, Johnston June6 challenges garrison duty and proposes useful mobile employment; p.910, Lee June7 retains preference while permitting retirement when opposition cannot succeed. [I] The ordinary government principal issues a hold through its existing Cooper channel on the sourced June3 lower bound. This is a bounded mission representation, not a claim that Cooper authored Lee's letter. No authored proposal or June6 action date; his planner and own response must produce his proposal."
    },
    {
      "post": "cs_cmd_harpers_ferry",
      "objective": "manassas",
      "fromDate": "1861-07-17",
      "requiresNotice": "manassas_advance_received",
      "source": "OR I-II p.478, Cooper telegram, Richmond to Johnston at Winchester, July 17: junction if practicable, with arrangements left to his discretion; p.473 gives Johnston's reported receipt about 1 a.m. July18 and decision to march. Read S94 page extracts OR-I-II-p478.txt and OR-I-II-p473.txt, SHA-256 in docs/audit/s96-evidence/source-reading.json. [I] Relieve Manassas with outmatched discretion to remain represents the conditional junction in 0114; ordinary received enemy knowledge, compliance, planning, routing and arrival decide it. The received advance notice still gates dispatch. No sick or baggage force, location, exact arrival or historical receipt is manufactured.",
      "posture": "relieve",
      "id": "johnston_junction",
      "discretion": {
        "condition": "outmatched",
        "fallback": {
          "objective": null,
          "posture": "hold"
        }
      }
    }
  ],
