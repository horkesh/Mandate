#!/bin/sh
# Git LFS's pre-push hook (lane 0.7l), here because the repository's hooks live in .githooks (core.hooksPath), where
# `git lfs install` would otherwise write it. It uploads the LFS objects a push needs. Without git-lfs it fails loudly:
# a push would otherwise send pointers whose objects are nowhere (docs/design/ASSETS.md 0.7).
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository keeps the binaries under art/ in Git LFS, but 'git-lfs' was not found on your path. Install it (https://git-lfs.com), run 'git lfs install --skip-repo', and push again."; exit 2; }
git lfs pre-push "$@"
