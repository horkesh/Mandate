{
  "name": "mandate",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundary": "node tools/check-pack-boundary.mjs",
    "check:licences": "tsx tools/check-licences.ts",
    "check": "npm run typecheck && npm run test && npm run check:boundary && npm run check:licences",
    "demo": "tsx packages/kernel/demo/directive-demo.ts",
    "run:testbed": "tsx packages/cli/src/run-testbed.ts",
    "run:pack": "tsx packages/cli/src/run-pack.ts",
    "run:headless": "tsx packages/cli/src/run-headless.ts",
    "run:seats": "tsx packages/cli/src/run-seats.ts",
    "play": "tsx packages/cli/src/play.ts",
    "pack:generate": "tsx packages/cli/src/pack.ts generate",
    "pack:validate": "tsx packages/cli/src/pack.ts validate",
    "pack:schemas": "tsx packages/cli/src/pack.ts schemas"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
