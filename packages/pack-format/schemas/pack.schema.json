"name": {"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},
"rules": {"additionalProperties":false,"properties":{"capacityMax":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"contest":{"additionalProperties":false,"description":"The simple control contest and occupation (0064): design parameters the pack states, not sourced facts.","properties":{"contestPermille":{"description":"Control the stronger side gains a day at an overwhelming margin, permille, times its margin. A design parameter.","maximum":1000,"minimum":0,"type":"integer"},"occupyFullMen":{"description":"The men at which occupation reaches its full rate; fewer gain in proportion. A design parameter.","maximum":9007199254740991,"minimum":1,"type":"integer"},"occupyPermille":{"description":"Control a side alone in held ground gains a day at full strength, permille. A design parameter.","maximum":1000,"minimum":0,"type":"integer"}},"required":["occupyPermille","occupyFullMen","contestPermille"],"type":"object"},"movement":{"additionalProperties":false,"description":"Movement and messages over the graph (0064): design parameters the pack states, not sourced facts.","properties":{"courierPermille":{"description":"A courier’s days on an edge, permille of a division’s, rounded up, at least one day. A design parameter.","maximum":1000,"minimum":1,"type":"integer"},"marchMinCapacityPermille":{"description":"The least capacity an edge needs this month to carry a march, permille of one unit of the capacity scale; at most capacityMax x 1000. A design parameter.","maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["marchMinCapacityPermille","courierPermille"],"type":"object"},"retreatControlPermille":{"maximum":1000,"minimum":0,"type":"integer"},"ruleSeats":{"additionalProperties":false,"description":"The generic rule-seat principal (0064): its standing goals stay at hold until its faction is at war, which a situation flag the pack names marks.","properties":{"warFlags":{"description":"One row per faction in the manifest.","items":{"additionalProperties":false,"properties":{"faction":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"flag":{"anyOf":[{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},{"type":"null"}],"description":"The situation chain flag that puts this faction at war; null for war from day 1."}},"required":["faction","flag"],"type":"object"},"type":"array"}},"required":["warFlags"],"type":"object"},"seasons":{"items":{"additionalProperties":false,"properties":{"capacityPermille":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"defaultMonths":{"items":{"maximum":12,"minimum":1,"type":"integer"},"minItems":1,"type":"array"},"lengthPermille":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"reason":{"enum":["mud","low_water","flood","ice"],"type":"string"}},"required":["reason","defaultMonths","lengthPermille","capacityPermille"],"type":"object"},"type":"array"},"stores":{"additionalProperties":false,"description":"Stores on hand (0040, 0064): design parameters the pack states, not sourced facts.","properties":{"capDays":{"description":"The most days of stores a block refills to. A design parameter.","maximum":9007199254740991,"minimum":1,"type":"integer"},"lowDays":{"description":"Stores below this many days are low, a truth event a report may tell; at most capDays. A design parameter.","maximum":9007199254740991,"minimum":0,"type":"integer"},"menPerCapacityUnit":{"description":"Men (and non-combatants) one unit of the capacity scale feeds for a day. A design parameter.","maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["menPerCapacityUnit","capDays","lowDays"],"type":"object"},"supplyControlPermille":{"maximum":1000,"minimum":0,"type":"integer"}},"required":["capacityMax","supplyControlPermille","retreatControlPermille","seasons","stores","contest","movement","ruleSeats"],"type":"object"},
"scenarios": {"items":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"minItems":1,"type":"array"},
"status": {"enum":["draft","release"],"type":"string"},
"vocabularies": {"additionalProperties":false,"properties":{"arms":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},"naval":{"type":"boolean"}},"required":["id","name","naval"],"type":"object"},"type":"array"},"blocs":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"}},"required":["id","name"],"type":"object"},"type":"array"},"departmentKinds":{"items":{"additionalProperties":false,"properties":{"government":{"default":false,"description":"A civil government that can hold a region’s jurisdiction (0058): only such a department may be named in a scenario’s governments. The engine reads this, never kind names.","type":"boolean"},"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},"selfGoverning":{"default":false,"description":"A government of a people who govern themselves (0069): only its own act, a notice, may change its side, close or reopen it, or move its regions, never a principal’s decision. Only a government may be self-governing.","type":"boolean"}},"required":["id","name"],"type":"object"},"type":"array"},"personKinds":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"}},"required":["id","name"],"type":"object"},"type":"array"},"postKinds":{"items":{"additionalProperties":false,"properties":{"creatable":{"enum":["start_only","appoint","directive"],"type":"string"},"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},"role":{"anyOf":[{"enum":["filter","intelligence"],"type":"string"},{"type":"null"}],"default":null,"description":"What the engine reads of this kind (0058): filter (holds or passes what comes in for its principal) or intelligence; null for any other kind. The engine never reads kind names."},"temporary":{"type":"boolean"}},"required":["id","name","creatable","temporary"],"type":"object"},"type":"array"},"ranks":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},"seniority":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["id","name","seniority"],"type":"object"},"type":"array"},"standingOrderKinds":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"}},"required":["id","name"],"type":"object"},"type":"array"},"terrains":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"},"roadLengthPermille":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"water":{"type":"boolean"}},"required":["id","name","roadLengthPermille","water"],"type":"object"},"type":"array"},"traits":{"items":{"additionalProperties":false,"properties":{"gate":{"type":"boolean"},"id":{"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$","type":"string"},"name":{"pattern":"^[a-z0-9_]+(?:\\.[a-z0-9_:-]+)*$","type":"string"}},"required":["id","name","gate"],"type":"object"},"type":"array"}},"required":["terrains","postKinds","departmentKinds","arms","personKinds","traits","ranks","blocs","standingOrderKinds"],"type":"object"}
},
